# Configurações de Banco de Dados
# Em desenvolvimento local (sem docker app):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/remind

# No Docker Compose, o hostname do banco é "postgres":
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/remind

# Credenciais do container Postgres (usadas pelo docker-compose.yml)
# Em VPS, use uma senha forte. A porta do banco só escuta em 127.0.0.1 por padrão.
POSTGRES_DB=remind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
# POSTGRES_BIND=127.0.0.1

# Configurações da Aplicação
PORT=3000
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=remind_session

# Usuário inicial (seed) — lido pelo docker-compose e por scripts/init-db.mjs.
# O seed só cria o usuário se o e-mail ainda não existir; não redefine senha em restarts.
SEED_USER_EMAIL=arthur@remind.local
SEED_USER_PASSWORD=remind123

# Controle de inicialização automática no container Docker
AUTO_RUN_DB_INIT=true
AUTO_RUN_DB_SEED=true
